{
  "name": "@branch-context/core",
  "version": "0.3.2",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./constants": {
      "types": "./dist/constants.d.ts",
      "development": "./src/constants.ts",
      "import": "./dist/constants.js"
    },
    "./services": {
      "types": "./dist/services/index.d.ts",
      "development": "./src/services/index.ts",
      "import": "./dist/services/index.js"
    },
    "./services/status": {
      "types": "./dist/services/status.d.ts",
      "development": "./src/services/status.ts",
      "import": "./dist/services/status.js"
    },
    "./services/actions": {
      "types": "./dist/services/actions.d.ts",
      "development": "./src/services/actions.ts",
      "import": "./dist/services/actions.js"
    }
  },
  "files": [
    "assets",
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "biome check .",
    "check:fix": "biome check --write ."
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.5.1",
    "vitest": "^4.1.0"
  }
}
