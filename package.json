{
  "name": "branch-context-monorepo",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.33.0",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "packages/pi/extensions"
    ]
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "prepare": "husky",
    "postinstall": "turbo run build --filter='./packages/*'",
    "build": "turbo run build",
    "build:no-cache": "turbo run build --force",
    "postbuild": "pnpm gen:docs",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "release": "changeset publish",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "biome check .",
    "check:docs": "pnpm gen:docs && git diff --exit-code README.md apps/cli/README.md",
    "check:fix": "biome check --write .",
    "gen:docs": "tsx scripts/update-docs/run.ts",
    "knip": "knip",
    "update-docs": "pnpm gen:docs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@changesets/cli": "^2.31.0",
    "@types/node": "^22.19.17",
    "husky": "^9.1.7",
    "knip": "^6.4.1",
    "lint-staged": "^16.4.0",
    "markdown-helper": "^0.0.0",
    "tsx": "^4.21.0",
    "turbo": "^2.9.6",
    "typescript": "^6.0.3",
    "unicommand": "^0.0.2"
  }
}
