{
  "name": "branch-context",
  "private": true,
  "version": "0.3.2",
  "bin": {
    "bctxd": "./scripts/bctxd"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "prepare": "husky",
    "postinstall": "turbo run build --filter='./packages/*'",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:cli": "scripts/bctxd",
    "dev:vscode": "pnpm --filter branch-context-vscode-extension dev",
    "bctxd:install": "mkdir -p ~/.local/bin && ln -sf \"$PWD/scripts/bctxd\" ~/.local/bin/bctxd",
    "bctxd:uninstall": "rm -f ~/.local/bin/bctxd",
    "vscode:build": "pnpm --filter branch-context-vscode-extension build",
    "vscode:package": "pnpm --filter branch-context-vscode-extension package",
    "vscode:install-local": "pnpm --filter branch-context-vscode-extension install-local",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "knip": "knip"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "husky": "^9.1.7",
    "knip": "^6.4.1",
    "lint-staged": "^16.4.0",
    "turbo": "^2.9.6",
    "typescript": "^6.0.3"
  }
}
