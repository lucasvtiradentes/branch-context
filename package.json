{
  "name": "branch-context-monorepo",
  "private": true,
  "version": "0.0.0",
  "bin": {
    "bctxd": "./apps/cli/scripts/bctxd"
  },
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "prepare": "husky",
    "postinstall": "turbo run build --filter='./packages/*'",
    "build": "turbo run build",
    "build:no-cache": "turbo run build --force",
    "postbuild": "tsx scripts/update-docs/run.ts",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "release": "changeset publish",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "knip": "knip",
    "update-docs": "tsx scripts/update-docs/run.ts",
    "bctxd:install": "mkdir -p ~/.local/bin && ln -sf \"$PWD/apps/cli/scripts/bctxd\" ~/.local/bin/bctxd",
    "bctxd:uninstall": "rm -f ~/.local/bin/bctxd"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@changesets/cli": "^2.31.0",
    "@types/node": "^22.19.17",
    "husky": "^9.1.7",
    "knip": "^6.4.1",
    "lint-staged": "^16.4.0",
    "markdown-helper": "^0.0.0",
    "tsx": "^4.21.0",
    "turbo": "^2.9.6",
    "typescript": "^6.0.3"
  }
}
