{
  "name": "branch-context-vscode-extension",
  "displayName": "Branch Context",
  "description": "Branch Context notes, status, commands, and context.md helpers for VS Code.",
  "version": "0.1.0",
  "private": false,
  "publisher": "lucasvtiradentes",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lucasvtiradentes/branch-context.git",
    "directory": "apps/vscode-extension"
  },
  "keywords": [
    "branch-context",
    "bctx",
    "git",
    "context",
    "markdown"
  ],
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "workspaceContains:.bctx/config.json",
    "onCommand:branch-context.openCurrentContext",
    "onCommand:branch-context.sync",
    "onCommand:branch-context.status",
    "onCommand:branch-context.setBase",
    "onCommand:branch-context.applyTemplate",
    "onCommand:branch-context.openConfig",
    "onCommand:branch-context.refreshViews",
    "onView:branch-context.currentContext",
    "onView:branch-context.recentContexts",
    "onView:branch-context.archivedContexts",
    "onView:branch-context.templates",
    "onView:branch-context.config"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "branch-context",
          "title": "Branch Context",
          "icon": "resources/branch-context.svg"
        }
      ]
    },
    "views": {
      "branch-context": [
        {
          "id": "branch-context.currentContext",
          "name": "Current Context"
        },
        {
          "id": "branch-context.recentContexts",
          "name": "Recent Contexts"
        },
        {
          "id": "branch-context.archivedContexts",
          "name": "Archived Contexts"
        },
        {
          "id": "branch-context.templates",
          "name": "Templates"
        },
        {
          "id": "branch-context.config",
          "name": "Config"
        }
      ]
    },
    "commands": [
      {
        "command": "branch-context.openCurrentContext",
        "title": "Branch Context: Open Current Context"
      },
      {
        "command": "branch-context.sync",
        "title": "Branch Context: Sync"
      },
      {
        "command": "branch-context.status",
        "title": "Branch Context: Status"
      },
      {
        "command": "branch-context.setBase",
        "title": "Branch Context: Set Base"
      },
      {
        "command": "branch-context.applyTemplate",
        "title": "Branch Context: Apply Template"
      },
      {
        "command": "branch-context.openConfig",
        "title": "Branch Context: Open Config"
      },
      {
        "command": "branch-context.refreshViews",
        "title": "Branch Context: Refresh Views"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "branch-context.refreshViews",
          "when": "view == branch-context.currentContext",
          "group": "navigation"
        },
        {
          "command": "branch-context.refreshViews",
          "when": "view == branch-context.recentContexts",
          "group": "navigation"
        },
        {
          "command": "branch-context.refreshViews",
          "when": "view == branch-context.archivedContexts",
          "group": "navigation"
        },
        {
          "command": "branch-context.refreshViews",
          "when": "view == branch-context.templates",
          "group": "navigation"
        },
        {
          "command": "branch-context.refreshViews",
          "when": "view == branch-context.config",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "install-local": "pnpm run build && tsx scripts/install-local-vscode.ts",
    "package": "vsce package --no-dependencies --out branch-context-vscode-extension-${npm_package_version}.vsix",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "vscode:prepublish": "pnpm run build"
  },
  "devDependencies": {
    "@branch-context/core": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.104.0",
    "@vscode/vsce": "^3.6.1",
    "tsx": "^4.21.0",
    "tsup": "^8.5.1"
  }
}
