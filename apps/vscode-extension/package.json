{
  "name": "branch-context-vscode",
  "displayName": "Branch Context",
  "description": "Branch Context notes, status, commands, and context.md helpers for VS Code.",
  "version": "0.1.0",
  "private": true,
  "publisher": "lucasvtiradentes",
  "license": "MIT",
  "icon": "resources/icon-colored.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/lucasvtiradentes/branch-context.git",
    "directory": "apps/vscode-extension"
  },
  "scripts": {
    "build": "pnpm run schema && tsup && pnpm run resources",
    "dev": "tsup --watch",
    "postbuild": "tsx scripts/install-local-vscode.ts",
    "install-local": "pnpm run build",
    "package": "vsce package --no-dependencies --out branch-context-vscode-${npm_package_version}.vsix",
    "resources": "tsx --conditions=development scripts/copy-core-resources.ts",
    "schema": "tsx --conditions=development scripts/generate-schema.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "vscode:prepublish": "pnpm run build"
  },
  "devDependencies": {
    "@branch-context/core": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.104.0",
    "@vscode/vsce": "^3.6.1",
    "tsx": "^4.21.0",
    "tsup": "^8.5.1"
  },
  "keywords": [
    "branch-context",
    "bctx",
    "git",
    "context",
    "markdown"
  ],
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "branch-context",
          "title": "Branch Context",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "branch-context": [
        {
          "id": "branch-context.currentContext",
          "name": "Branch Context",
          "icon": "resources/icon.svg"
        },
        {
          "id": "branch-context.agentSessions",
          "name": "Branch AI Sessions",
          "icon": "resources/icon.svg"
        },
        {
          "id": "branch-context.gitChanges",
          "name": "Branch Git Changes",
          "icon": "resources/icon.svg"
        },
        {
          "id": "branch-context.contexts",
          "name": "Other Branches",
          "icon": "resources/icon.svg"
        },
        {
          "id": "branch-context.templates",
          "name": "Templates",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "branch-context.openCurrentContext",
        "title": "Branch Context: Open Current Context",
        "icon": "$(go-to-file)"
      },
      {
        "command": "branch-context.sync",
        "title": "Branch Context: Sync",
        "icon": "$(sync)"
      },
      {
        "command": "branch-context.status",
        "title": "Branch Context: Status",
        "icon": "$(pulse)"
      },
      {
        "command": "branch-context.setBase",
        "title": "Branch Context: Set Base",
        "icon": "$(git-branch)"
      },
      {
        "command": "branch-context.applyTemplate",
        "title": "Branch Context: Apply Template",
        "icon": "$(symbol-namespace)"
      },
      {
        "command": "branch-context.openConfig",
        "title": "Branch Context: Open Config",
        "icon": "$(settings-gear)"
      },
      {
        "command": "branch-context.openCurrentContextFolder",
        "title": "Branch Context: Open Current Context Folder",
        "icon": "$(folder-opened)"
      },
      {
        "command": "branch-context.reviewDiff",
        "title": "Branch Context: Branch Git Diff",
        "icon": "$(diff)"
      },
      {
        "command": "branch-context.copyCommitHash",
        "title": "Branch Context: Copy Commit Hash",
        "icon": "$(copy)"
      },
      {
        "command": "branch-context.openCommitOnOrigin",
        "title": "Branch Context: Open Commit on Origin",
        "icon": "$(github)"
      },
      {
        "command": "branch-context.resetFilesToCommit",
        "title": "Branch Context: Reset Files To Commit",
        "icon": "$(discard)"
      },
      {
        "command": "branch-context.toggleGitChangesMode",
        "title": "Branch Context: Toggle Git Changes Mode",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "branch-context.groupGitChangedFilesBy",
        "title": "Branch Context: Group Changed Files By",
        "icon": "$(list-tree)"
      },
      {
        "command": "branch-context.groupGitCommitsBy",
        "title": "Branch Context: Group Git Commits By",
        "icon": "$(list-tree)"
      },
      {
        "command": "branch-context.groupAgentSessionsBy",
        "title": "Branch Context: Group Agent Sessions By",
        "icon": "$(list-tree)"
      },
      {
        "command": "branch-context.toggleAgentSessionText",
        "title": "Branch Context: Toggle Agent Session Text",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "branch-context.resumeAgentSession",
        "title": "Branch Context: Resume Agent Session",
        "icon": "$(debug-continue)"
      },
      {
        "command": "branch-context.showActiveAgentSession",
        "title": "Branch Context: Agent Session Active",
        "icon": "$(circle-filled)"
      },
      {
        "command": "branch-context.pinAgentSession",
        "title": "Branch Context: Pin Agent Session",
        "icon": "$(pinned)"
      },
      {
        "command": "branch-context.unpinAgentSession",
        "title": "Branch Context: Unpin Agent Session",
        "icon": "$(pinned-dirty)"
      },
      {
        "command": "branch-context.copyAgentSessionId",
        "title": "Branch Context: Copy Session ID",
        "icon": "$(copy)"
      },
      {
        "command": "branch-context.deleteAgentSession",
        "title": "Branch Context: Delete Session",
        "icon": "$(trash)"
      },
      {
        "command": "branch-context.groupContextsBy",
        "title": "Branch Context: Group Other Branches By",
        "icon": "$(list-tree)"
      },
      {
        "command": "branch-context.toggleOtherBranchesMode",
        "title": "Branch Context: Toggle Other Branches Mode",
        "icon": "$(arrow-swap)"
      },
      {
        "command": "branch-context.moveAgentSessionToBranch",
        "title": "Branch Context: Move Session To Branch",
        "icon": "$(git-branch)"
      },
      {
        "command": "branch-context.checkoutContextBranch",
        "title": "Branch Context: Checkout Branch",
        "icon": "$(git-branch)"
      },
      {
        "command": "branch-context.openContext",
        "title": "Branch Context: Open Context",
        "icon": "$(go-to-file)"
      },
      {
        "command": "branch-context.revealContextFolder",
        "title": "Branch Context: Open Context Folder",
        "icon": "$(folder-opened)"
      },
      {
        "command": "branch-context.archiveContext",
        "title": "Branch Context: Archive Context",
        "icon": "$(archive)"
      },
      {
        "command": "branch-context.restoreContext",
        "title": "Branch Context: Restore Context",
        "icon": "$(history)"
      },
      {
        "command": "branch-context.deleteContext",
        "title": "Branch Context: Delete Context",
        "icon": "$(trash)"
      },
      {
        "command": "branch-context.updateCli",
        "title": "Branch Context: Update CLI",
        "icon": "$(terminal)"
      },
      {
        "command": "branch-context.showLogs",
        "title": "Branch Context: Show Logs",
        "icon": "$(output)"
      },
      {
        "command": "branch-context.internal.syncAgents",
        "title": "Branch Context: Sync Agents",
        "icon": "$(sync)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "workbench.view.extension.branch-context",
          "when": "false"
        },
        {
          "command": "branch-context.currentContext.focus",
          "when": "false"
        },
        {
          "command": "branch-context.agentSessions.focus",
          "when": "false"
        },
        {
          "command": "branch-context.gitChanges.focus",
          "when": "false"
        },
        {
          "command": "branch-context.contexts.focus",
          "when": "false"
        },
        {
          "command": "branch-context.templates.focus",
          "when": "false"
        },
        {
          "command": "branch-context.openCurrentContext",
          "when": "false"
        },
        {
          "command": "branch-context.sync",
          "when": "false"
        },
        {
          "command": "branch-context.status",
          "when": "false"
        },
        {
          "command": "branch-context.setBase",
          "when": "false"
        },
        {
          "command": "branch-context.applyTemplate",
          "when": "false"
        },
        {
          "command": "branch-context.openConfig",
          "when": "false"
        },
        {
          "command": "branch-context.openCurrentContextFolder",
          "when": "false"
        },
        {
          "command": "branch-context.reviewDiff",
          "when": "false"
        },
        {
          "command": "branch-context.copyCommitHash",
          "when": "false"
        },
        {
          "command": "branch-context.openCommitOnOrigin",
          "when": "false"
        },
        {
          "command": "branch-context.resetFilesToCommit",
          "when": "false"
        },
        {
          "command": "branch-context.toggleGitChangesMode",
          "when": "false"
        },
        {
          "command": "branch-context.groupGitChangedFilesBy",
          "when": "false"
        },
        {
          "command": "branch-context.groupGitCommitsBy",
          "when": "false"
        },
        {
          "command": "branch-context.groupAgentSessionsBy",
          "when": "false"
        },
        {
          "command": "branch-context.toggleAgentSessionText",
          "when": "false"
        },
        {
          "command": "branch-context.resumeAgentSession",
          "when": "false"
        },
        {
          "command": "branch-context.pinAgentSession",
          "when": "false"
        },
        {
          "command": "branch-context.unpinAgentSession",
          "when": "false"
        },
        {
          "command": "branch-context.copyAgentSessionId",
          "when": "false"
        },
        {
          "command": "branch-context.deleteAgentSession",
          "when": "false"
        },
        {
          "command": "branch-context.groupContextsBy",
          "when": "false"
        },
        {
          "command": "branch-context.toggleOtherBranchesMode",
          "when": "false"
        },
        {
          "command": "branch-context.moveAgentSessionToBranch",
          "when": "false"
        },
        {
          "command": "branch-context.checkoutContextBranch",
          "when": "false"
        },
        {
          "command": "branch-context.openContext",
          "when": "false"
        },
        {
          "command": "branch-context.revealContextFolder",
          "when": "false"
        },
        {
          "command": "branch-context.archiveContext",
          "when": "false"
        },
        {
          "command": "branch-context.restoreContext",
          "when": "false"
        },
        {
          "command": "branch-context.deleteContext",
          "when": "false"
        },
        {
          "command": "branch-context.internal.syncAgents",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "branch-context.sync",
          "when": "view == branch-context.currentContext && branch-context.initialized",
          "group": "navigation@1"
        },
        {
          "command": "branch-context.setBase",
          "when": "view == branch-context.currentContext && branch-context.initialized",
          "group": "navigation@3"
        },
        {
          "command": "branch-context.applyTemplate",
          "when": "view == branch-context.currentContext && branch-context.initialized",
          "group": "navigation@4"
        },
        {
          "command": "branch-context.openCurrentContextFolder",
          "when": "view == branch-context.currentContext && branch-context.initialized",
          "group": "navigation@5"
        },
        {
          "command": "branch-context.reviewDiff",
          "when": "view == branch-context.gitChanges && branch-context.initialized",
          "group": "navigation@1"
        },
        {
          "command": "branch-context.toggleGitChangesMode",
          "when": "view == branch-context.gitChanges && branch-context.initialized",
          "group": "navigation@2"
        },
        {
          "command": "branch-context.groupGitChangedFilesBy",
          "when": "view == branch-context.gitChanges && branch-context.initialized && branch-context.gitChangesMode == files",
          "group": "navigation@3"
        },
        {
          "command": "branch-context.groupGitCommitsBy",
          "when": "view == branch-context.gitChanges && branch-context.initialized && branch-context.gitChangesMode == commits",
          "group": "navigation@3"
        },
        {
          "command": "branch-context.groupAgentSessionsBy",
          "when": "view == branch-context.agentSessions && branch-context.initialized",
          "group": "navigation@2"
        },
        {
          "command": "branch-context.toggleAgentSessionText",
          "when": "view == branch-context.agentSessions && branch-context.initialized",
          "group": "navigation@1"
        },
        {
          "command": "branch-context.toggleOtherBranchesMode",
          "when": "view == branch-context.contexts && branch-context.initialized",
          "group": "navigation@1"
        },
        {
          "command": "branch-context.groupContextsBy",
          "when": "view == branch-context.contexts && branch-context.initialized",
          "group": "navigation@2"
        },
        {
          "command": "branch-context.openConfig",
          "when": "view == branch-context.templates && branch-context.initialized",
          "group": "navigation@1"
        }
      ],
      "view/item/context": [
        {
          "command": "branch-context.checkoutContextBranch",
          "when": "view == branch-context.contexts && viewItem =~ /checkoutable/",
          "group": "navigation@1"
        },
        {
          "command": "branch-context.openContext",
          "when": "view == branch-context.contexts && viewItem =~ /branchContext\\.context/",
          "group": "navigation@2"
        },
        {
          "command": "branch-context.revealContextFolder",
          "when": "view == branch-context.contexts && viewItem =~ /branchContext\\.context/",
          "group": "navigation@3"
        },
        {
          "command": "branch-context.archiveContext",
          "when": "view == branch-context.contexts && viewItem =~ /archivable/",
          "group": "2_manage@1"
        },
        {
          "command": "branch-context.restoreContext",
          "when": "view == branch-context.contexts && viewItem =~ /restorable/",
          "group": "2_manage@2"
        },
        {
          "command": "branch-context.deleteContext",
          "when": "view == branch-context.contexts && viewItem =~ /deletable/",
          "group": "9_destructive@1"
        },
        {
          "command": "branch-context.resumeAgentSession",
          "when": "(view == branch-context.agentSessions || view == branch-context.contexts) && viewItem =~ /branchContext\\.agentSession.*resumable/",
          "group": "inline@1"
        },
        {
          "command": "branch-context.showActiveAgentSession",
          "when": "(view == branch-context.agentSessions || view == branch-context.contexts) && viewItem =~ /branchContext\\.agentSession.*active/",
          "group": "inline@1"
        },
        {
          "command": "branch-context.pinAgentSession",
          "when": "(view == branch-context.agentSessions || view == branch-context.contexts) && viewItem =~ /branchContext\\.agentSession.*pinnable/",
          "group": "inline@0"
        },
        {
          "command": "branch-context.unpinAgentSession",
          "when": "(view == branch-context.agentSessions || view == branch-context.contexts) && viewItem =~ /branchContext\\.agentSession.*pinned/",
          "group": "inline@0"
        },
        {
          "command": "branch-context.moveAgentSessionToBranch",
          "when": "view == branch-context.contexts && viewItem =~ /movable/",
          "group": "navigation@1"
        },
        {
          "command": "branch-context.resumeAgentSession",
          "when": "(view == branch-context.agentSessions || view == branch-context.contexts) && viewItem =~ /branchContext\\.agentSession.*resumable/",
          "group": "navigation@2"
        },
        {
          "command": "branch-context.pinAgentSession",
          "when": "(view == branch-context.agentSessions || view == branch-context.contexts) && viewItem =~ /branchContext\\.agentSession.*pinnable/",
          "group": "navigation@3"
        },
        {
          "command": "branch-context.unpinAgentSession",
          "when": "(view == branch-context.agentSessions || view == branch-context.contexts) && viewItem =~ /branchContext\\.agentSession.*pinned/",
          "group": "navigation@3"
        },
        {
          "command": "branch-context.copyAgentSessionId",
          "when": "(view == branch-context.agentSessions || view == branch-context.contexts) && viewItem =~ /branchContext\\.agentSession/",
          "group": "navigation@4"
        },
        {
          "command": "branch-context.deleteAgentSession",
          "when": "(view == branch-context.agentSessions || view == branch-context.contexts) && viewItem =~ /branchContext\\.agentSession/",
          "group": "9_destructive@1"
        },
        {
          "command": "branch-context.copyCommitHash",
          "when": "view == branch-context.gitChanges && viewItem == branchContext.commit",
          "group": "navigation@1"
        },
        {
          "command": "branch-context.openCommitOnOrigin",
          "when": "view == branch-context.gitChanges && viewItem == branchContext.commit",
          "group": "navigation@2"
        },
        {
          "command": "branch-context.resetFilesToCommit",
          "when": "view == branch-context.gitChanges && viewItem == branchContext.commit",
          "group": "9_destructive@1"
        }
      ]
    },
    "jsonValidation": [
      {
        "fileMatch": "**/.bctx/config.json",
        "url": "./resources/schema.json"
      }
    ]
  }
}
